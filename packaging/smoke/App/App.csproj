<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EvergreenFS.Build" Version="$(SmokeVersion)" PrivateAssets="all" />
    <PackageReference Include="EvergreenSmoke.Dependency" Version="$(SmokeVersion)" />
  </ItemGroup>
</Project>
