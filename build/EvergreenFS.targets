<Project>
  <Target Name="EvergreenRewrite" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)../src/EvergreenFS.Rewriter/bin/$(Configuration)/net10.0/EvergreenFS.Rewriter.dll&quot; &quot;$(TargetPath)&quot; --closure" />
  </Target>
</Project>
